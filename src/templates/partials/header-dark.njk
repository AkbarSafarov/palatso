{% from "blocks/main-menu.njk" import render as mainMenuBlock %}
{% from "blocks/mobile-menu.njk" import render as mobileMenuBlock %}
{% from "blocks/mobile-search.njk" import render as mobileSearchBlock %}

<nav id="mobile-nav" class="mobile-nav" aria-label="Мобильная навигация" inert>
    {{ mobileSearchBlock({ class: "mobile-nav__search" }) }}
    {{ mobileMenuBlock(mainMenu, { class: "mobile-nav__menu" }) }}
    <div class="mobile__email">
        <svg width="16" height="16" aria-hidden="true" focusable="false">
            <use href="#iconEmail" />
        </svg>
        <a href="mailto:schpon-kostroma@yandex.ru">schpon-kostroma@yandex.ru</a>
    </div>
</nav>

<div class="search-block form-wrap">
    <div class="container">
        <div class="container-inner">
            <form>
                <div class="form-del-wrap">
                    <input class="input--js" type="text" placeholder="Поиск по сайту">
                    <button class="search-block__search" type="button" aria-label="Найти">
                        <svg width="16" height="16" aria-hidden="true" focusable="false">
                            <use href="#iconSearch" />
                        </svg>
                    </button>
                    <button class="search-block__del search-del--js" type="button" aria-label="Очистить"></button>
                </div>
            </form>
            <button class="search-block__cross search-toggle--js" type="button" aria-label="Закрыть поиск"></button>
            <ul class="search-block__result">
                <li><a href="#">Фасады МДФ</a></li>
                <li><a href="#">Фасады крашеные</a></li>
                <li><a href="#">Шпон натуральный</a></li>
                <li><a href="#">Покраска фасадов</a></li>
                <li><a href="#">Мебель на заказ</a></li>
                <li><a href="#">Контакты</a></li>
            </ul>
        </div>
    </div>
</div>
<header class="header header__dark" role="banner">
    <div class="container">
        <div class="header__inner ">
            <div class="header__logo">
                <a href="/"  aria-label="Строй Нова — на главную">
                    <svg width="151" height="29" aria-hidden="true" focusable="false">
                        <use href="#logo" />
                    </svg>
                </a>
            </div>
            <div class="header__desc">Производство <br>фасадов</div>
            <div class="header__center">
                {{ mainMenuBlock(mainMenu, { dark: true }) }}
                <div class="header__search">
                    <button class="header__search_btn">
                        <svg width="16" height="16" aria-hidden="true" focusable="false">
                            <use href="#iconSearch" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="header__right">
                <div class="header__contacts">
                    <div class="header__contacts_col">
                        <div class="header__address">
                            <svg width="16" height="16" aria-hidden="true" focusable="false">
                                <use href="#iconLocation" />
                            </svg>
                            <span>Москва</span>
                        </div>
                        <div class="header__phone">
                            <a href="">
                                <img src="/assets/images/mx-dark.svg" alt="">
                            </a>
                            <a href="tel:+79101937999">8 (910) 193-79-99</a>
                        </div>
                    </div>
                    <div class="header__contacts_col-bottom">
                        <div class="header__email">
                            <svg width="16" height="16" aria-hidden="true" focusable="false">
                                <use href="#iconEmail" />
                            </svg>
                            <a href="mailto:schpon-kostroma@yandex.ru">schpon-kostroma@yandex.ru</a>
                        </div>
                        <button class="btn__link btn__link-call" data-src="#modal-contacts" data-fancybox>Заказать звонок</button>
                    </div>
                </div>
            </div>
            <button
                class="header__burger"
                aria-label="Открыть меню"
                aria-expanded="false"
                aria-controls="mobile-nav"
            >
                <svg width="30" height="22" viewBox="0 0 30 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line y1="1" x2="30" y2="1" stroke="white" stroke-width="2"/>
                    <line y1="11" x2="30" y2="11" stroke="white" stroke-width="2"/>
                    <line y1="21" x2="30" y2="21" stroke="white" stroke-width="2"/>
                </svg>

            </button>
        </div>
    </div>
</header>

{# Modal: Заказать звонок #}
<div id="modal-contacts" class="fancybox__content modal-contacts" style="display:none;">
    <div class="modal-win modal-win--call-a-master">
        <div class="form-wrap">
            <div class="text-center">
                <div class="modal-win__title">Заполните анкету</div>
            </div>
            <form class="modal-win__form" action="/" method="POST" novalidate>
                <div class="modal-win__group">
                    <label class="modal-win__label" for="modal-name">Ваше Имя</label>
                    <input class="modal-win__input" id="modal-name" name="user_name" type="text" placeholder="Ваше Имя">
                </div>
                <div class="modal-win__group">
                    <label class="modal-win__label" for="modal-phone">Телефон</label>
                    <input class="modal-win__input" id="modal-phone" name="user_phone" type="tel" placeholder="+7 (___) ___-__-__" inputmode="tel">
                </div>
                <div class="modal-win__group">
                    <label class="modal-win__label" for="modal-email">E-mail</label>
                    <input class="modal-win__input" id="modal-email" name="user_email" type="email" placeholder="E-mail">
                </div>
                <div class="modal-win__group">
                    <label class="modal-win__label" for="modal-city">Город</label>
                    <input class="modal-win__input" id="modal-city" name="user_city" type="text" placeholder="Москва">
                </div>
                <div class="modal-win__group">
                    <label class="modal-win__label" for="modal-company">Название компании</label>
                    <input class="modal-win__input" id="modal-company" name="user_name_company" type="text" placeholder="Компания">
                </div>
                <button class="modal-win__submit" type="submit">Отправить</button>
                <p class="modal-win__policy">
                    Нажимая кнопку «Отправить» я соглашаюсь с
                    <a href="/politika/">Положением о персональных данных и конфиденциальности.</a>
                </p>
            </form>
        </div>
    </div>
</div>

